rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'f1Vb911OgwTvPFB1wl4WGgiL8au2';
    }

    function hasSupportedRole() {
      return request.resource.data.role in ['farmer', 'resident'];
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && hasSupportedRole();
      allow update: if (isAdmin() && hasSupportedRole()) ||
        (request.auth != null && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /crops/{id} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
  }
}
